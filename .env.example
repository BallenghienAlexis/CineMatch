# 🔐 ENVIRONMENT VARIABLES TEMPLATE
#
# IMPORTANT:
# 1. Copy this file: cp .env.example .env.local
# 2. Fill in your actual API keys below
# 3. NEVER commit .env.local to Git (it's in .gitignore)
# 4. Never share these keys publicly
#
# This file (.env.example) is safe to commit (has placeholder values)
#

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🎬 THE MOVIE DATABASE (TMDB) API
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#
# HOW TO GET:
# 1. Visit: https://www.themoviedb.org/settings/api
# 2. Sign up (free account)
# 3. Go to API section
# 4. Copy your "API Read Access Token" (v4 auth) — NOT the old v3 key
# 5. Paste it below
#
# FORMAT: Long JWT token starting with "eyJhbGciOiJIUzI1NiJ9..."
#
# EXAMPLE (INVALID - DO NOT USE):
# eyJhbGciOiJIUzI1NiJ9.eyJhdWQiOlsidG1kYi1hcGkiXSwiY3JlYXRlZF9hdCI6MTcyMDMxMDMxMjIsImV4cCI6MjAzMzY2Njc5MiwiZm9yZ290dGVuIjp0cnVlfQ.l5_2qxPl3_gFQkgB0qoVa3QQgB0qoVa3QQgB0qoVa3Q
#
EXPO_PUBLIC_TMDB_API_KEY=your_tmdb_token_here


# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🗄️ SUPABASE PROJECT CONFIGURATION
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#
# HOW TO GET:
# 1. Sign up: https://supabase.com
# 2. Create new project (or select existing)
# 3. Go to Settings → API (left menu)
# 4. Copy:
#    - Project URL
#    - Anon (public) key
#
# ⚠️ IMPORTANT: Use ANON key, NOT the service_role key
#
# FORMAT:
# - URL: https://xxxxx.supabase.co
# - KEY: JWT token starting with "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
#

# Supabase Project URL
# EXAMPLE: https://my-project-xyz.supabase.co
EXPO_PUBLIC_SUPABASE_URL=https://your-project-name.supabase.co

# Supabase Anon (public) Key - for client-side auth
# EXAMPLE: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here


# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# ✅ SETUP VALIDATION
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#
# After filling above:
#
# 1. Rename this file to .env.local:
#    $ cp .env.example .env.local
#
# 2. Edit .env.local with your real keys (not this template)
#
# 3. Restart Expo:
#    $ npm start
#    (Press Ctrl+C to stop, then restart)
#
# 4. Check console for errors:
#    - "Cannot read process.env.EXPO_PUBLIC_TMDB_API_KEY" = not filled
#    - "Supabase connection failed" = wrong URL or key
#    - No errors = SUCCESS ✅
#
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━


